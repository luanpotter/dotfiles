#!/usr/bin/env bash

# the vim script next to this one (through the ~/bin/scripts link)
lib="$(dirname "$(readlink -f "$0")")/_dp"

mapfile -t queue < <(git status --porcelain --untracked-files=all | awk '/^.[MARCD]/ || /^\?\?/ { sub(/^.../, ""); print }')

view() {
	local file="$1" left="${#queue[@]}"
	local diff_tmp
	diff_tmp=$(mktemp)
	if git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
		git --no-pager diff -- "$file" >"$diff_tmp"
	else
		{
			echo "(untracked)"
			git --no-pager diff --no-index /dev/null "$file" 2>/dev/null || true
		} >"$diff_tmp"
	fi

	DP_DIFF="$diff_tmp" DP_FILE="$file" DP_LEFT="$left" \
		vim -n -N -u NONE -S "$lib/dp.vim" "$diff_tmp"
	local rc=$?
	rm -f "$diff_tmp"
	return $rc
}

# last few files seen and what was done to them, for going back
hist_files=()
hist_acts=()

remember() {
	hist_files+=("$1")
	hist_acts+=("$2")
	if [ ${#hist_files[@]} -gt 3 ]; then
		hist_files=("${hist_files[@]:1}")
		hist_acts=("${hist_acts[@]:1}")
	fi
}

go_back() {
	local n=${#hist_files[@]} prev act i
	queue=("$1" "${queue[@]}")
	[ "$n" -eq 0 ] && return
	prev="${hist_files[n - 1]}"
	act="${hist_acts[n - 1]}"
	unset 'hist_files[n - 1]' 'hist_acts[n - 1]'
	case $act in
	add) git restore --staged -- "$prev" ;;
	defer) # drop the copy that was pushed to the end
		for ((i = ${#queue[@]} - 1; i >= 0; i--)); do
			if [ "${queue[i]}" = "$prev" ]; then
				queue=("${queue[@]:0:i}" "${queue[@]:i+1}")
				break
			fi
		done
		;;
	esac
	queue=("$prev" "${queue[@]}")
}

while [ ${#queue[@]} -gt 0 ]; do
	file="${queue[0]}"
	queue=("${queue[@]:1}")
	view "$file"
	case $? in
	10) git add -- "$file" && remember "$file" add ;;
	20) remember "$file" skip ;;
	30) queue+=("$file") && remember "$file" defer ;;
	40) exit 0 ;;
	50) go_back "$file" ;;
	*) queue=("$file" "${queue[@]}") ;; # crash / unknown exit: re-queue
	esac
done
