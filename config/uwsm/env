# Adds ~/bin to PATH for the graphical session (launcher, wayland, etc).
#
# Sourced by uwsm while preparing the session env (/usr/lib/uwsm/prepare-env.sh),
# after /etc/profile and ~/.profile. uwsm rebuilds PATH from that profile chain
# starting from empty, so it discards other sources. See uwsm(1).
export PATH="$HOME/bin:$PATH"

# allow for accent composition w/o an input compositor (for GTK apps)
export GTK_IM_MODULE=simple
