# theme and style
macos-titlebar-style = hidden

# no padding: hyprland gaps and borders already space the text from the
# edges, and gaps_out in hyprland.lua is tuned assuming the grid fills
# the window
window-padding-x = 0
window-padding-y = 0

# linux (gtk, ignored on macos): no header bar or window buttons under
# hyprland; tabs come from tmux instead
gtk-titlebar = false

## macos: the corner key is cmd (karabiner swaps cmd and ctrl, see
## karabiner.json), so send the ctrl byte for every cmd+letter, the way the
## same key does on linux. this overrides ghostty's macos defaults (cmd+j
## scroll_to_selection, cmd+k clear_screen, cmd+t new_tab, ...) and the
## cmd+h/m menu items. not bound: cmd+q (quit; ctrl+q is never needed),
## cmd+v (paste, see the clipboard section at the bottom), and cmd+space /
## cmd+tab, which macos takes before ghostty sees them. as on any legacy
## terminal, ctrl+i, ctrl+m and ctrl+[ are the same bytes as tab, enter and esc
keybind = cmd+a=text:\x01
keybind = cmd+b=text:\x02
keybind = cmd+c=text:\x03
keybind = cmd+d=text:\x04
keybind = cmd+e=text:\x05
keybind = cmd+f=text:\x06
keybind = cmd+g=text:\x07
keybind = cmd+h=text:\x08
keybind = cmd+i=text:\x09
keybind = cmd+j=text:\x0a
keybind = cmd+k=text:\x0b
keybind = cmd+l=text:\x0c
keybind = cmd+m=text:\x0d
keybind = cmd+n=text:\x0e
keybind = cmd+o=text:\x0f
keybind = cmd+p=text:\x10
keybind = cmd+r=text:\x12
keybind = cmd+s=text:\x13
keybind = cmd+t=text:\x14
keybind = cmd+u=text:\x15
keybind = cmd+w=text:\x17
keybind = cmd+x=text:\x18
keybind = cmd+y=text:\x19
keybind = cmd+z=text:\x1a

# ctrl+[ (esc), ctrl+] and ctrl+\ (sigquit)
keybind = cmd+[=text:\x1b
keybind = cmd+]=text:\x1d
keybind = cmd+backslash=text:\x1c

# tab switching with single keybind
keybind = cmd+digit_1=text:\x02\x30
keybind = cmd+digit_2=text:\x02\x31
keybind = cmd+digit_3=text:\x02\x32
keybind = cmd+digit_4=text:\x02\x33
keybind = cmd+digit_5=text:\x02\x34
keybind = cmd+digit_6=text:\x02\x35
keybind = cmd+digit_7=text:\x02\x36
keybind = cmd+digit_8=text:\x02\x37
keybind = cmd+digit_9=text:\x02\x38

# same with ctrl on linux; ctrl+t/w already go to tmux (see tmux.conf)
keybind = ctrl+digit_1=text:\x02\x30
keybind = ctrl+digit_2=text:\x02\x31
keybind = ctrl+digit_3=text:\x02\x32
keybind = ctrl+digit_4=text:\x02\x33
keybind = ctrl+digit_5=text:\x02\x34
keybind = ctrl+digit_6=text:\x02\x35
keybind = ctrl+digit_7=text:\x02\x36
keybind = ctrl+digit_8=text:\x02\x37
keybind = ctrl+digit_9=text:\x02\x38

# delete previous word: sends alt+backspace, since ctrl+w closes the tmux window
keybind = ctrl+backspace=text:\x1b\x7f

# arrows on macos: ghostty's macos defaults turn cmd+left/right/backspace into
# ctrl-a/ctrl-e/ctrl-u and alt+left/right into "esc b"/"esc f". karabiner swaps
# ctrl and cmd, so the key used as ctrl arrives here as cmd (see karabiner.json,
# which sends ctrl+arrows to ghostty as cmd+arrows). cmd+arrows move by word
# with the same bytes ctrl+arrows produce on linux, alt+arrows go to the start
# and end of the line as home/end. same split for backspace: cmd deletes a
# word (alt+backspace bytes), alt deletes to the start of the line (ctrl-u)
keybind = cmd+arrow_left=text:\x1b[1;5D
keybind = cmd+arrow_right=text:\x1b[1;5C
keybind = cmd+backspace=text:\x1b\x7f
keybind = alt+arrow_left=text:\x1b[H
keybind = alt+arrow_right=text:\x1b[F
keybind = alt+backspace=text:\x15

# cycle tmux windows (prefix + p / n). also bound on cmd for macos
keybind = ctrl+page_up=text:\x02p
keybind = ctrl+page_down=text:\x02n
keybind = cmd+page_up=text:\x02p
keybind = cmd+page_down=text:\x02n

# clipboard: cmd+shift+c/v on macos mirror ghostty's ctrl+shift+c/v defaults on
# linux. cmd+v stays a plain paste since ctrl+v (literal-next) is never needed
keybind = cmd+shift+c=copy_to_clipboard
keybind = cmd+shift+v=paste_from_clipboard
keybind = performable:cmd+v=paste_from_clipboard
